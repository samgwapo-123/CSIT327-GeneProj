# Copy this file to .env and replace every placeholder.
# Never commit the real .env file.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Supabase PostgreSQL connection string.
# Get it from: Supabase Dashboard -> Project Settings -> Database -> Connect
# Use the Session Pooler string if your network is IPv4-only.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/postgres
